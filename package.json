{
  "name": "nmsh",
  "version": "0.18.0",
  "description": "A cleaner terminal frontend for zsh with persistent input, autocomplete, semantic highlighting, scrollable history, and better command feedback.",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "nmsh": "bin/nmsh"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "predev": "node scripts/ensure-node-pty-helper.mjs",
    "nmsh": "node dist/index.js",
    "test": "node scripts/test.mjs",
    "bench": "node --import=tsx scripts/benchmarks.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/write-build-info.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:fast": "node scripts/test.mjs --suite=fast",
    "test:node22": "node scripts/test.mjs --suite=node22",
    "test:fedora": "node scripts/test.mjs --suite=fedora",
    "typecheck:bench": "tsc --ignoreConfig --noEmit --types node --target ES2022 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck scripts/benchmarks.ts scripts/platform-benchmarks.ts scripts/idle-benchmarks.ts",
    "bench:smoke": "node scripts/timing-smoke.mjs",
    "verify:fast": "npm run build && npm run test:fast && git diff --check",
    "verify": "npm run build && npm test && git diff --check",
    "verify:release": "npm run verify && npm run typecheck:bench && npm run bench:smoke",
    "demos": "node scripts/demos/render.mjs",
    "promo": "node scripts/demos/promo.mjs",
    "demos:check": "node scripts/demos/check.mjs"
  },
  "keywords": [
    "terminal",
    "zsh",
    "shell",
    "pty",
    "terminal-ui",
    "ghostty",
    "macos",
    "typescript"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "module",
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "node-pty": "^1.1.0",
    "smol-toml": "1.9.0",
    "string-width": "^8.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raiseCatError/notMyShell.git"
  },
  "homepage": "https://github.com/raiseCatError/notMyShell",
  "engines": {
    "node": ">=22"
  }
}
