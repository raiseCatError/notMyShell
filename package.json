{
  "name": "nmsh",
  "version": "1.0.0",
  "description": "A cleaner terminal frontend for zsh with persistent input, autocomplete, semantic highlighting, scrollable history, and better command feedback.",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "nmsh": "bin/nmsh"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "predev": "node scripts/ensure-node-pty-helper.mjs",
    "nmsh": "node dist/index.js",
    "test": "node --import=tsx --test tests/**/*.test.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "terminal",
    "zsh",
    "shell",
    "pty",
    "terminal-ui",
    "ghostty",
    "macos",
    "typescript"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "module",
  "dependencies": {
    "ink": "^7.1.1",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "string-width": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raiseCatError/notMyShell.git"
  },
  "homepage": "https://github.com/raiseCatError/notMyShell"
}
