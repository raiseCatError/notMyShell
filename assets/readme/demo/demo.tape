Output assets/readme/nmsh-demo.gif

Set FontSize 15
Set Width 800
Set Height 500
Set Padding 10
Set Margin 10
Set MarginFill "#0E0E12"
Set BorderRadius 8
Set Theme "Catppuccin Macchiato"

Type "nmsh"
Enter
Sleep 2s

Type "git status"
Enter
Sleep 1s

Type "echo $HOME | grep Projects"
Enter
Sleep 1s

Type "sleep 3"
Enter
Sleep 5s

Type "echo hello"
Enter
Sleep 2s
