# Rich motion, live status, failure feedback and the real animation previews.
Output assets/readme/motion.gif
# demo-config: {"motion":{"rendering":"rich","commandLaunch":"sweep","contextTransitions":"expressive","completionHighlight":"vivid","completionEffect":"seal","eventFeedback":"expressive","cursorTravel":"on"},"presentation":{"preset":"aurora","motion":"travel"},"statusStrip":{"enabled":true,"clock":true,"cpu":false,"ram":false,"battery":false}}

Hide
Type "cd ~/Projects/demo && clear && nmsh"
Enter
Sleep 5s
Show

Type "npm test"
Enter
Sleep 4s
Type "cat missing.txt"
Enter
Sleep 2s
Type "/setup motion"
Enter
Sleep 2s
Down
Sleep 2s
Down
Sleep 2s
Down
Sleep 2s
Escape
Sleep 1s
