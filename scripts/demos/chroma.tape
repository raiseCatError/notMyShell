# Multiple gradients, animated Chroma and turning it off to see base colors.
Output assets/readme/chroma.gif
# demo-config: {"presentation":{"preset":"aurora","motion":"travel"}}

Hide
Type "cd ~/Projects/demo && clear && nmsh"
Enter
Sleep 5s
Show

Type "/chroma"
Enter
Sleep 2s
Right
Sleep 3s
Right
Sleep 3s
Right
Sleep 3s
Down
Down
Sleep 2s
Escape
Type "/prompt"
Enter
Sleep 2s
Type "c"
Sleep 3s
Escape
