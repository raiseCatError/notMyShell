# Named screensavers, real motion; any key restores the composer.
Output assets/readme/screensavers-motion.gif

Hide
Type "cd ~/Projects/demo && clear && nmsh"
Enter
Sleep 5s
Show

Type "ls src test"
Enter
Sleep 1s
Type "/screensaver start sparkles"
Enter
Sleep 4s
Type "q"
Sleep 0.6s
Type "/screensaver start fireworks"
Enter
Sleep 4s
Type "q"
Sleep 0.6s
Type "/screensaver start blackHole"
Enter
Sleep 4s
Type "q"
Sleep 0.6s
Type "/screensaver start screenFireworks"
Enter
Sleep 4s
Type "q"
Sleep 0.6s
Type "/screensaver start circletastic"
Enter
Sleep 4s
Type "q"
Sleep 0.6s
