# Shared framing for every NMSh demo; render.mjs prepends it (and the demo
# environment) to each tape. Keep these consistent across recordings.
Set Shell "zsh"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 15
Set LineHeight 1.15
Set Width 1080
Set Height 640
Set Padding 18
Set WindowBar Colorful
Set BorderRadius 8
Set Margin 0
Set Framerate 24
Set PlaybackSpeed 1
Set TypingSpeed 70ms
Set CursorBlink false
Set Theme { "name": "NMSh Demo", "black": "#1b1a24", "red": "#cd737b", "green": "#74b59a", "yellow": "#e3c48f", "blue": "#8aa4e6", "magenta": "#c5b9e8", "cyan": "#7fc4cc", "white": "#d8d6de", "brightBlack": "#6b6f7b", "brightRed": "#e2939a", "brightGreen": "#94cdb4", "brightYellow": "#f0d9a8", "brightBlue": "#a9bdf0", "brightMagenta": "#dcd2f4", "brightCyan": "#a0d8de", "brightWhite": "#f2f0ec", "background": "#15141c", "foreground": "#f2f0ec", "selection": "#585f91", "cursor": "#c5b9e8" }
