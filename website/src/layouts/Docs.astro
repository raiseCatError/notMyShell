---
import Base from './Base.astro';
import DocNavigation from '../components/DocNavigation.astro';
import { documents, docNavigation, groupId } from '../lib/docs';
import { launch, launchLabel, sourceUrl } from '../lib/site';
interface Props { title: string; description: string; slug: string; headings: { depth: number; slug: string; text: string }[]; source?: string; sources?: string[]; editorial?: string[] }
const { title, description, slug, headings, source, sources = [], editorial = [] } = Astro.props;
const entries = await documents();
const currentIndex = entries.findIndex(entry => entry.slug === slug);
const previous = entries[currentIndex - 1];
const next = entries[currentIndex + 1];
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const sourcePaths = source ? [source] : sources;
const currentGroup = docNavigation(entries).find(group => group.articles.some(entry => entry.slug === slug) || group.children.some(child => child.articles.some(entry => entry.slug === slug)));
const currentSubgroup = currentGroup?.children.find(group => group.articles.some(entry => entry.slug === slug));
---
<Base title={title} description={description} docs>
  <div class="docs-grid">
    <aside class="docs-sidebar" aria-label="Documentation navigation" data-pagefind-ignore>
      <a href="/docs/" class="sidebar-title">Documentation <span>↗</span></a>
      <a class="version-label" href="/releases/#launch-baseline">{launchLabel}</a>
      <DocNavigation entries={entries} slug={slug} label="Documentation sections" />
    </aside>
    <div class="docs-main">
      <details class="docs-mobile" data-pagefind-ignore><summary>Documentation menu</summary><DocNavigation entries={entries} slug={slug} label="Mobile documentation" /></details>
    <script is:inline>
      {
        const sidebar = document.querySelector('.docs-sidebar');
        const storageKey = 'nmsh-docs-sidebar-scroll';
        const expandedKey = 'nmsh-docs-expanded-v2';
        const navigations = [...document.querySelectorAll('.doc-navigation')];
        const groups = document.querySelectorAll('.doc-navigation details[data-doc-group]');
        try {
          const expanded = JSON.parse(sessionStorage.getItem(expandedKey) || '{}');
          for (const group of groups) {
            const value = expanded?.[group.dataset.docGroup];
            if (typeof value === 'boolean') group.open = value;
          }
          const stored = sessionStorage.getItem(storageKey);
          const position = Number(stored);
          if (stored !== null && Number.isFinite(position) && position >= 0) sidebar.scrollTop = position;
        } catch {}
        for (const navigation of navigations) {
          let ancestor = navigation.querySelector('[aria-current="page"]')?.closest('details[data-doc-group]');
          while (ancestor) { ancestor.open = true; ancestor = ancestor.parentElement.closest('details[data-doc-group]'); }
        }
        function revealCurrent(scroller) {
          const current = scroller.querySelector('[aria-current="page"]');
          if (!scroller.offsetParent || !current) return;
          const top = current.getBoundingClientRect().top - scroller.getBoundingClientRect().top;
          const bottom = top + current.offsetHeight - scroller.clientHeight;
          if (top < 0) scroller.scrollTop += top;
          else if (bottom > 0) scroller.scrollTop += bottom;
        }
        revealCurrent(sidebar);
        const mobileMenu = document.querySelector('.docs-mobile');
        mobileMenu.addEventListener('toggle', () => { if (mobileMenu.open) revealCurrent(mobileMenu.querySelector('.doc-navigation')); });
        function saveSidebarPosition() {
          try {
            if (sidebar.offsetParent) sessionStorage.setItem(storageKey, String(sidebar.scrollTop));
            const navigation = navigations.find(element => element.offsetParent);
            if (navigation) sessionStorage.setItem(expandedKey, JSON.stringify(Object.fromEntries([...navigation.querySelectorAll('details[data-doc-group]')].map(group => [group.dataset.docGroup, group.open]))));
          } catch {}
        }
        for (const navigation of navigations) {
          navigation.addEventListener('click', event => {
            const link = event.target instanceof Element ? event.target.closest('a') : null;
            if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            saveSidebarPosition();
            if (link.getAttribute('aria-current') === 'page') event.preventDefault();
          });
          navigation.addEventListener('toggle', saveSidebarPosition, true);
        }
        window.addEventListener('pagehide', saveSidebarPosition);
      }
    </script>
      <nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore><a href="/docs/">Docs</a><span aria-hidden="true">/</span>{currentGroup && <><a href={`/docs/#${groupId(currentGroup.title)}`}>{currentGroup.title}</a><span aria-hidden="true">/</span></>}{currentSubgroup && <><span>{currentSubgroup.title}</span><span aria-hidden="true">/</span></>}<span aria-current="page">{title}</span></nav>
      {toc.length > 1 && <details class="toc-mobile" data-pagefind-ignore><summary>On this page</summary><nav aria-label="On this page (compact)">{toc.map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></details>}
      <article class="prose" data-pagefind-body style={`view-transition-name: docs-article-${slug.replaceAll('/', '-') || 'index'}`}>
        <header class="doc-heading"><span class="eyebrow">{source ? 'Pinned technical reference' : 'The NMSh handbook'}</span><h1 data-pagefind-meta="title">{title}</h1><p class="lead">{description}</p></header>
        {source && <aside class="note"><strong>Source snapshot · {launchLabel}</strong><p>This repository document retains its original design notes and caveats. Historical proposals in it are not all product commitments. <a href={sourceUrl(source)}>Read the canonical source ↗</a></p></aside>}
        {editorial.length > 0 && <aside class="note"><strong>Editorial update</strong>{editorial.map(note => <p>{note}</p>)}<p>The canonical source at the tagged release is unchanged.</p></aside>}
        <slot />
      </article>
      <div class="doc-provenance" data-pagefind-ignore><span>Reviewed against {launchLabel} · source {launch.commit.slice(0, 8)} · {launch.verifiedAt}</span>{sourcePaths.length > 0 && <div>Sources: {sourcePaths.map((path, index) => <>{index > 0 && ' · '}<a href={sourceUrl(path)}>{path.split('/').pop()}</a></>)}</div>}<a href={`https://github.com/raiseCatError/notMyShell/issues/new?title=${encodeURIComponent(`Documentation: ${title}`)}`}>Suggest a correction ↗</a></div>
      <nav class="doc-pagination" aria-label="Previous and next pages" data-pagefind-ignore>{previous ? <a href={`/docs/${previous.slug}/`}><small>← Previous</small><span>{previous.data.title}</span></a> : <span></span>}{next && <a href={`/docs/${next.slug}/`}><small>Next →</small><span>{next.data.title}</span></a>}</nav>
    </div>
    <aside class="docs-toc" data-pagefind-ignore>{toc.length > 1 && <nav aria-label="On this page"><h2>On this page</h2>{toc.map(heading => <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}</nav>}<a class="toc-source" href="/releases/#launch-baseline">Version and release status →</a></aside>
  </div>
</Base>

<style is:global>
  @view-transition { navigation: auto; }
  html { view-transition-name: none; }
  ::view-transition { pointer-events: none; }
  ::view-transition-group(*) { animation: none; }
  ::view-transition-old(*), ::view-transition-new(*) { mix-blend-mode: normal; }
  ::view-transition-old(*) { animation: docs-article-exit 100ms ease-out both; }
  ::view-transition-new(*) { animation: docs-article-enter 180ms ease-out 30ms both; }
  @keyframes docs-article-exit { to { opacity: 0; } }
  @keyframes docs-article-enter { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    @view-transition { navigation: none; }
    ::view-transition-old(*), ::view-transition-new(*) { animation: none; }
  }
</style>
