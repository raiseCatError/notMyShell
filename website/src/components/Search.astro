<dialog id="docs-search" aria-labelledby="search-title">
  <div class="search-top"><h2 id="search-title">Documentation</h2><button type="button" id="search-close" class="text-button">Close <kbd>Esc</kbd></button></div>
  <form role="search" id="search-form">
    <label for="search-input">Search documentation</label>
    <input id="search-input" type="search" placeholder="Search guides and reference…" autocomplete="off" enterkeyhint="search" />
  </form>
  <p id="search-status" class="muted" role="status">Try “sessions” or “Theme Bridge”. Search runs in your browser.</p>
  <ol id="search-results"></ol>
  <p class="search-footer"><a href="/docs/">Browse all documentation instead <span aria-hidden="true">→</span></a></p>
</dialog>
