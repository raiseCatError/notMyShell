---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import { launchLabel } from '../lib/site';
const groups = [
  { title: 'Interaction', text: 'A composer with its own space. Edit multiline commands, see shell-aware classification and get completion candidates before you submit.', items: ['Bottom, Top and Flow layouts', 'One-line or two-line composer', 'Command status and elapsed time'], link: 'composer', label: 'Composer and input' },
  { title: 'Transcript & sessions', text: 'Work with the record of a command, not just a wall of output. Live sessions preserve a continuing shell when a frontend window detaches.', items: ['Command blocks, folding, find and filter', 'Plain-text copy, without frontend chrome', 'Explicit session discovery and resume'], link: 'sessions', label: 'Sessions and resume' },
  { title: 'Execution workflows', text: 'Queue commands in the same shell, see what is running and review what follows. Keep long-running tools in separate session-owned background tasks.', items: ['Serial queue with pause and reviewed resume', 'Live execution timeline and optional output folding', 'Background task manager and separate live output'], link: 'execution', label: 'Queue and background tasks' },
  { title: 'Appearance', text: 'Choose a native theme, import a palette or build your own. Prompt, layout and motion preferences are separate, so you can change one without changing everything.', items: ['Theme Studio and opt-in Theme Bridge', 'Native, Starship, Oh My Posh, Powerlevel10k or None', 'Chroma, Vespyr, safe glyphs and reduced motion'], link: 'themes', label: 'Themes and Chroma' },
  { title: 'Tools & integrations', text: 'Use the tools you choose, with explicit installation plans and configuration boundaries. NMSh remains a frontend, not a replacement editor.', items: ['Managed Claude Code beta with native model and effort controls', 'Worktree management and read-only GitHub workspace', 'Optional experimental sidebar and panel, Off by default'], link: 'integrations', label: 'Tools and integrations' },
  { title: 'Context & modules', text: 'Capabilities collect facts; modules turn them into useful context. Route them to the prompt, Context Rail, Right Context or Status Strip.', items: ['Demand-driven scheduling and bounded local reads', 'Project, runtimes, Git, system and local cloud profiles', 'Declarative local Context Packs, not executable plugins'], link: 'context', label: 'Context Engine and modules' },
  { title: 'Control & ownership', text: 'Your shell configuration is executable code, not a file to rewrite casually. Imports are data, and changes have a reviewable boundary.', items: ['No account, telemetry or cloud typing path', 'Ownership ledger for managed generated files', 'Exact diffs and explicit package-manager plans'], link: 'configuration', label: 'Configuration and settings' },
];
---
<Base title="Features" description="A closer look at NMSh: composer, transcript, live sessions, themes, native context and deliberate integration boundaries.">
  <div class="container"><header class="page-hero"><span class="eyebrow">The product / {launchLabel}</span><h1>Keep your shell.<br />Change how you work.</h1><p class="lead">Edit commands, follow execution and work with the results. NMSh gives each part of everyday shell use a place in the interface.</p></header>
    {groups.map(group => <section class="feature-row"><h2>{group.title}</h2><div><p>{group.text}</p><a class="text-link spaced" href={`/docs/${group.link}/`}>{group.label} <span>→</span></a></div><ul>{group.items.map(item => <li>{item}</li>)}</ul></section>)}
    <section class="section"><div class="section-heading"><h2>A closer look.</h2><p>Product media is being prepared separately. For now, each guide explains the controls, behavior and limits.</p></div><div class="feature-media-grid"><Media id="theme-studio" /><Media id="session-resume" /><Media id="context-modules" /><Media id="vespyr-appearance" /></div></section>
    <section class="section"><div class="callout-band"><div><h2>Understand the boundary.</h2><p>NMSh is not a shell, emulator, multiplexer or AI-first terminal. It belongs between your terminal host and a persistent real shell.</p></div><a class="button secondary" href="/architecture/">How it works <span>→</span></a></div></section>
  </div>
</Base>
