---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dateLabel, release } from '../../lib/site';
export async function getStaticPaths() { return (await getCollection('releases')).map(entry => ({ params: { tag: entry.data.tag }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`${entry.data.tag} release notes`} description={`Published NMSh ${entry.data.tag} release notes, ${dateLabel(entry.data.date)}. Imported from the actual public GitHub release.`}>
  <div class="container"><header class="page-hero"><span class="eyebrow">Published release / {dateLabel(entry.data.date)}</span><h1>{entry.data.tag}</h1><p class="lead">{entry.data.tag === release.latest.tag ? 'Latest stable release.' : `Historical release. Latest stable is ${release.latest.tag}.`} The original publication's caveats and limitations are preserved below.</p><div class="actions"><a class="text-link" href={entry.data.url}>Original GitHub release <span>↗</span></a><a class="text-link" href="/releases/">All releases <span>→</span></a></div></header><article class="prose measure" style="padding-bottom: 80px"><Content /></article></div>
</Base>
