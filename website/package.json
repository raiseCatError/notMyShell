{
  "name": "@nmsh/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --ignore-lock",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/validate-content.mjs && astro build --force && pagefind --site dist && node scripts/check-site.mjs",
    "preview": "astro preview --host 127.0.0.1 --ignore-lock",
    "test:browser": "playwright test",
    "verify": "npm test && npm run check && npm run build && npm run test:browser",
    "sync:upstream": "node scripts/sync-upstream.mjs --write",
    "check:upstream": "node scripts/sync-upstream.mjs --check"
  },
  "dependencies": { "astro": "7.4.0", "@astrojs/markdown-remark": "7.3.3" },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "pagefind": "1.5.2",
    "typescript": "~5.9.3"
  }
}
